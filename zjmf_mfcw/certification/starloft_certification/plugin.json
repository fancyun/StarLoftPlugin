{
    "name": "StarLoft 人脸核验",
    "version": "2.4.0",
    "description": "对接「星楼网络」人脸核验(FV)服务的人脸识别认证插件（智简魔方财务版）。有源人脸核验（fv_auth），支持个人与企业实名（企业先三/四要素核验再扫脸，可在后台配置）。",
    "author": "StarLoft",
    "website": "https://docs.starloft.cn/fv/plugin",
    "plugin_type": "certification",
    "dir": "starloft_certification",
    "namespace": "certification\\starloft_certification",
    "class": "StarloftCertificationPlugin",
    "support_personal": true,
    "support_company": true,
    "requires": {
        "zjmf_version": ">=3.7.6",
        "php_version": ">=7.0",
        "extensions": [
            "curl",
            "json"
        ]
    },
    "config": {
        "api_url": {
            "title": "API地址",
            "type": "text",
            "required": true,
            "default": "https://api.starloft.cn"
        },
        "api_key": {
            "title": "API Key",
            "type": "text",
            "required": true
        },
        "api_secret": {
            "title": "API Secret",
            "type": "password",
            "required": true
        },
        "service": {
            "title": "人脸核验体服务标识(service)",
            "type": "text",
            "required": false,
            "default": "fv_auth"
        },
        "skip_notify": {
            "title": "跳过平台异步通知",
            "type": "radio",
            "options": {
                "1": "启用",
                "0": "禁用"
            },
            "required": false,
            "default": "0"
        },
        "require_reconcile": {
            "title": "落地前结果校对",
            "type": "radio",
            "options": {
                "1": "启用",
                "0": "禁用"
            },
            "required": false,
            "default": "1"
        },
        "min_age": {
            "title": "最小年龄限制（周岁）",
            "type": "text",
            "required": false,
            "default": "0"
        },
        "max_age": {
            "title": "最大年龄限制（周岁）",
            "type": "text",
            "required": false,
            "default": "0"
        },
        "company_verify_mode": {
            "title": "企业要素核验方式",
            "type": "radio",
            "required": false,
            "default": "biz3",
            "options": {
                "biz3": "三要素（企业名称+统一社会信用代码+法人姓名）",
                "biz4": "四要素（三要素+法人身份证号）",
                "off": "关闭（不核验，直接法人扫脸）"
            }
        },
        "return_url": {
            "title": "认证完成回跳地址",
            "type": "text",
            "required": false,
            "default": "/user/certification"
        }
    }
}