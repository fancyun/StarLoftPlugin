{
    "name": "StarLoft 短信服务",
    "version": "3.0.0",
    "description": "对接「星楼网络」短信服务(SMS)的短信插件（智简魔方业务系统 v10 · 平台模板型）。支持国内短信：模板管理（getCnTemplate/createCnTemplate/putCnTemplate/deleteCnTemplate）与发送（sendCnSms），安装时自动导入全部系统模板。",
    "author": "StarLoft",
    "website": "https://docs.starloft.cn/sms/plugin",
    "plugin_type": "sms",
    "dir": "starloft_sms",
    "namespace": "sms\\starloft_sms",
    "class": "StarloftSms",
    "support": {
        "cn": true,
        "global": false
    },
    "requires": {
        "php_version": ">=7.0",
        "extensions": [
            "curl",
            "json"
        ]
    },
    "config": {
        "amount": {
            "title": "单条短信费用",
            "type": "text",
            "required": false,
            "default": "0"
        },
        "free": {
            "title": "免费短信条数",
            "type": "text",
            "required": false,
            "default": "0"
        },
        "api_url": {
            "title": "API地址",
            "type": "text",
            "required": true,
            "default": "https://api.starloft.cn"
        },
        "api_key": {
            "title": "API Key",
            "type": "text",
            "required": true
        },
        "api_secret": {
            "title": "API Secret",
            "type": "password",
            "required": true
        },
        "sign_name": {
            "title": "默认短信签名内容",
            "type": "text",
            "required": false
        },
        "sms_type": {
            "title": "默认短信类型",
            "type": "select",
            "options": {
                "verify": "验证码短信",
                "notify": "通知短信"
            },
            "required": false,
            "default": "notify"
        }
    }
}
