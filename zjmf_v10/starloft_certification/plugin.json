{
    "name": "StarLoft 人脸核验",
    "version": "2.0.0",
    "description": "对接「星楼网络」人脸核验(FV)服务的人脸识别认证插件（智简魔方业务系统 v10）。有源人脸核验（fv_auth），仅支持个人实名。",
    "author": "StarLoft",
    "website": "https://docs.starloft.cn/fv/plugin",
    "plugin_type": "certification",
    "dir": "starloft_certification",
    "namespace": "certification\\starloft_certification",
    "class": "StarloftCertification",
    "support_personal": true,
    "support_company": false,
    "requires": {
        "php_version": ">=7.0",
        "extensions": [
            "curl",
            "json"
        ]
    },
    "config": {
        "api_url": {
            "title": "API地址",
            "type": "text",
            "required": true,
            "default": "https://api.starloft.cn"
        },
        "api_key": {
            "title": "API Key",
            "type": "text",
            "required": true
        },
        "api_secret": {
            "title": "API Secret",
            "type": "password",
            "required": true
        },
        "service": {
            "title": "人脸核验体服务标识(service)",
            "type": "text",
            "required": false,
            "default": "fv_auth"
        },
        "skip_notify": {
            "title": "跳过平台异步通知",
            "type": "radio",
            "options": {
                "1": "启用",
                "0": "禁用"
            },
            "required": false,
            "default": "0"
        },
        "require_reconcile": {
            "title": "落地前结果校对",
            "type": "radio",
            "options": {
                "1": "启用",
                "0": "禁用"
            },
            "required": false,
            "default": "1"
        }
    }
}